# ---------------------------------------------------------------------------
# School in a Box — environment template
# Copy to `.env` (repo root, read by docker compose + backend) and
# `frontend/.env.local` (the NEXT_PUBLIC_* values). Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Local infrastructure (docker-compose.yml) ------------------------------
POSTGRES_USER=siab
POSTGRES_PASSWORD=siab
POSTGRES_DB=siab
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
S3_PORT=8333
# Origins allowed to PUT files straight into local S3 (CORS), comma-separated (3100 = E2E)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Backend ----------------------------------------------------------------
# development | test | production
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://siab:siab@localhost:5432/siab
REDIS_URL=redis://localhost:6379/0
# CORS allow-origin (comma-separated for several)
FRONTEND_URL=http://localhost:3000

# Supabase Auth — JWT verification.
# Newer projects sign with asymmetric keys: set SUPABASE_URL and the JWKS
# endpoint is derived (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
# Legacy projects sign with HS256: set SUPABASE_JWT_SECRET.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Rate limiting (general API, per user per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# Uploads per user per hour (SECURITY_MODEL §5.1)
RATE_LIMIT_UPLOADS_PER_HOUR=5

# --- Vector store (Qdrant) --------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Object storage (S3-compatible) -----------------------------------------
# Local: the SeaweedFS S3 gateway from docker-compose (keys in infra/seaweedfs/s3.json).
# Production: leave S3_ENDPOINT_URL empty for AWS S3, or use the R2 endpoint.
S3_ENDPOINT_URL=http://localhost:8333
# Endpoint written into presigned URLs if browsers reach S3 by a different host
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=siab-uploads
S3_ACCESS_KEY_ID=siab-local-access
S3_SECRET_ACCESS_KEY=siab-local-secret-key

# --- Background jobs (Celery) -----------------------------------------------
# Default to REDIS_URL when empty
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- AI (ADR-003: provider-abstracted, configuration-driven) -----------------
# The default provider is any OpenAI-compatible endpoint: OpenAI (default URL),
# or e.g. Ollama http://localhost:11434/v1, Groq, Together, OpenRouter, vLLM.
LLM_DEFAULT_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
# Example: Google Gemini free tier via its OpenAI-compatible endpoint (key from Google AI Studio)
# LLM_API_KEY=<your key>
# LLM_DEFAULT_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_TASKS__CONCEPT_EXTRACTION__PROVIDER=gemini   (repeat for every task + embedding)
# LLM_TASKS__CONCEPT_EXTRACTION__MODEL=gemini-3.6-flash
# LLM_TASKS__QUESTION_GENERATION__MODEL=gemini-3.5-flash-lite
# LLM_TASKS__EMBEDDING__MODEL=gemini-embedding-001
# LLM_TASKS__EMBEDDING__DIMENSIONS=768
# QDRANT_SECTIONS_COLLECTION=document_sections_gemini_768
# CONTENT__EXTRACTION_CONCURRENCY=2
# Google retires older models for new users: on a 404, move to a newer model name.
#
# Example: fully local with Ollama (no key; `ollama pull qwen2.5:3b nomic-embed-text`)
# LLM_DEFAULT_PROVIDER=ollama
# LLM_PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434/v1
# LLM_PROVIDERS__OLLAMA__TIMEOUT_SECONDS=900
# LLM_TASKS__CONCEPT_EXTRACTION__PROVIDER=ollama   (repeat for every task + embedding)
# LLM_TASKS__CONCEPT_EXTRACTION__MODEL=qwen2.5:3b
# LLM_TASKS__EMBEDDING__MODEL=nomic-embed-text
# LLM_TASKS__EMBEDDING__DIMENSIONS=768
# QDRANT_SECTIONS_COLLECTION=document_sections_nomic_768   (new collection when the size changes)
# CONTENT__EXTRACTION_CONCURRENCY=1
# Per-task overrides (merged onto the defaults in backend/app/config.py), e.g.
# LLM_TASKS__CONCEPT_EXTRACTION__MODEL=gpt-4o-mini
# LLM_TASKS__EMBEDDING__MODEL=text-embedding-3-small
# Extra providers, then point a task at them:
# LLM_PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434/v1
# LLM_PROVIDERS__OLLAMA__SUPPORTS_JSON_MODE=true
# LLM_TASKS__CONCEPT_EXTRACTION__PROVIDER=ollama
# Prices (USD per 1M tokens) for cost tracking of models not in the defaults:
# AI_PRICING={"llama3.1": {"input_per_1m": 0, "output_per_1m": 0}}
AI_DAILY_BUDGET_USD=5.00
AI_SESSION_TOKEN_BUDGET=50000
# Store full prompts/responses in ai_interactions.metadata (audit trail)
AI_LOG_CONTENT=true

# --- Frontend (frontend/.env.local) -----------------------------------------
# Server-side only (read at request time by the Next.js server; never shipped to
# the browser). The browser talks to the API via the same-origin /api/backend proxy.
# frontend/.env.local also needs SUPABASE_URL (same value as the backend's, above).
SUPABASE_ANON_KEY=
API_URL=http://localhost:8000/api/v1
# Public origin used in sign-up confirmation e-mails
SITE_URL=http://localhost:3000
