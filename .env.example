# ---------------------------------------------------------------------------
# School in a Box — environment template
# Copy to `.env` (repo root, read by docker compose + backend) and
# `frontend/.env.local` (the NEXT_PUBLIC_* values). Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Local infrastructure (docker-compose.yml) ------------------------------
POSTGRES_USER=siab
POSTGRES_PASSWORD=siab
POSTGRES_DB=siab
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Backend ----------------------------------------------------------------
# development | test | production
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://siab:siab@localhost:5432/siab
REDIS_URL=redis://localhost:6379/0
# CORS allow-origin (comma-separated for several)
FRONTEND_URL=http://localhost:3000

# Supabase Auth — JWT verification.
# Newer projects sign with asymmetric keys: set SUPABASE_URL and the JWKS
# endpoint is derived (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
# Legacy projects sign with HS256: set SUPABASE_JWT_SECRET.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Rate limiting (general API, per user per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# --- Later phases (not used in Phase 2) -------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
AI_DAILY_BUDGET_USD=5.00
AI_SESSION_TOKEN_BUDGET=50000

# --- Frontend (frontend/.env.local) -----------------------------------------
# Server-side only (read at request time by the Next.js server; never shipped to
# the browser). The browser talks to the API via the same-origin /api/backend proxy.
# frontend/.env.local also needs SUPABASE_URL (same value as the backend's, above).
SUPABASE_ANON_KEY=
API_URL=http://localhost:8000/api/v1
# Public origin used in sign-up confirmation e-mails
SITE_URL=http://localhost:3000
